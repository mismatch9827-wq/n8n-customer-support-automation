    {
      "parameters": {
        "jsCode": "const real=items.filter(i=>i.json['Ticket ID']!=='None');\nconst lines=real.map(i=>`• ${i.json['Ticket ID']} | ${i.json.Priority} | ${i.json['Assigned Team'] ?? 'Unassigned'} | ${i.json.Description}`).join('\\n');\nreturn [{json:{count:real.length,digest:real.length ? lines : 'No tickets have exceeded the 24-hour SLA.'}}];"
      },
