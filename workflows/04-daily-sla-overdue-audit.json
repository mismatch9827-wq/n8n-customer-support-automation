      "parameters": {
        "jsCode": "const now=Date.now();\nconst overdue=items.filter(({json:t})=>{\n const open=['Open','Triaged','In Progress'].includes(t.Status ?? t.status);\n const created=Date.parse(t['Created At'] ?? t.submittedAt ?? '');\n return open && !Number.isNaN(created) && now-created > 24*60*60*1000;\n});\nreturn overdue.length ? overdue : [{json:{'Ticket ID':'None','Description':'No overdue tickets','Priority':'-', 'Created At':'-'}}];"
      },
